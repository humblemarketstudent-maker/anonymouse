# Moderation agent. Copy to .env for local runs of `npm run moderation`.
# Do not put these values in Vite variables (no VITE_ prefix) or in client code.
# The static site never receives this file.

# HTTP port. Render sets PORT; locally the Vite dev server proxies to 8787.
PORT=8787

# Required for /admin and the admin API. Use a long random value.
# The browser asks for it at /admin and keeps it in sessionStorage only.
MODERATION_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional salt mixed into session hashes. Leave blank to hash the id alone.
MODERATION_ACTOR_SALT=

# Real-time alerts. Leave blank to skip webhooks. Never commit a real URL.
MODERATION_ALERT_WEBHOOK_URL=
MODERATION_WEBHOOK_TIMEOUT_MS=2000

# Optional OpenAI-compatible classifier. With these empty, deterministic
# checks still mask PII, block leaks, block explicit text, and quarantine
# attachments the scanner cannot clear.
MODERATION_LLM_BASE_URL=
MODERATION_LLM_API_KEY=
MODERATION_LLM_MODEL=
MODERATION_LLM_TIMEOUT_MS=4000

# Optional vision model id on the same base URL. A timeout or error
# quarantines the attachment instead of publishing it.
MODERATION_VISION_MODEL=
MODERATION_VISION_TIMEOUT_MS=5000
MODERATION_SCAN_TIMEOUT_MS=4000

# Append-only JSONL audit log. Leave blank for memory only.
# Render's filesystem is ephemeral unless you attach a disk.
MODERATION_AUDIT_PATH=

# The SPA calls same-origin /api/moderation/inspect. Set to false when a
# private backend imports the module itself and this HTTP bridge should be off.
MODERATION_PUBLIC_INSPECT=true

# Optional browser origin allowed to call a separately hosted agent.
# Leave blank for same-origin deployments.
MODERATION_CORS_ORIGIN=

# Max JSON body, bytes. Attachments are capped at 450 KB before this.
MODERATION_MAX_BODY_BYTES=700000

# Rate limit and repeat-offender escalation.
MODERATION_RATE_MAX=40
MODERATION_RATE_WINDOW_MS=60000
MODERATION_STRIKE_LIMIT=5
MODERATION_STRIKE_WINDOW_MS=600000
MODERATION_COOLDOWN_MS=60000

# Vite only, not bundled into the client. Where `npm run dev` proxies /api/moderation.
MODERATION_ORIGIN=http://127.0.0.1:8787

# Email OTP auth service (`npm run auth`). Separate from moderation.
# Never prefix these with VITE_. Never commit real Twilio values.
# Render sets PORT. Locally AUTH_PORT wins over PORT so this does not
# take the moderation agent's 8787. Leave Twilio blank until you have them.
# Twilio Verify sends the code on the email channel. No From phone number.

AUTH_PORT=8788
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://anonymouse.lol,https://www.anonymouse.lol,https://anonymouse-eafk.onrender.com
# Must stay false for any public or production process. true only works when NODE_ENV is not production.
ALLOW_DEMO_OTP=false

# Vite only. Leave blank to keep the in-browser demo code 000000.
# Set to the auth API origin and rebuild the static site to send real codes.
# Local proxy example, after `npm run auth`: http://127.0.0.1:43123
VITE_AUTH_API_BASE=

# Where `npm run dev` proxies /api/auth. Not bundled into the client.
AUTH_ORIGIN=http://127.0.0.1:8788
